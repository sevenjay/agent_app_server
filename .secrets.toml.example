# Private Dynaconf values. Rename this file to .secrets.toml.
# Never commit the real .secrets.toml file.
#
# The MVP does not accept a Codex API key. It reuses the service account's
# existing ~/.codex authentication. Put host-specific Dynaconf overrides here
# only when the deployment needs them.

# Single-user, header-free deployment:
# [default]
# deployment_mode = "single_user"
# codex_bin = "/home/user/.npm-global/bin/codex"
# node_bin = "/usr/bin/node"
# codex_projects_root = "~/codex-workspaces"

# oauth2-proxy / Keycloak multi-tenant deployment:
# [production]
# deployment_mode = "multi_tenant"
# codex_bin = "/usr/.npm-global/bin/codex"
# node_bin = "/usr/bin/node"
# codex_projects_root = "/codex"

